# Local env files live per app — copy and edit:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/dashboard/.env.example apps/dashboard/.env
#
# The repo root .env is not loaded by the API or dashboard.

# Trust Railway edge-set X-Real-IP only when all traffic reaches the API through Railway.
# Defaults to true in production, false otherwise. Disable for other hosting.
# TRUST_RAILWAY_EDGE=true
# Temporary IP-only diagnostics; never logs authorization or forwarding secrets.
IP_DIAGNOSTIC_LOG=false
