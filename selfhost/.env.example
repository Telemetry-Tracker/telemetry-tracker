# Telemetry Tracker self-host settings. Copy to selfhost/.env and fill in the three secrets.
# No defaults are shipped for secrets: `docker compose up` refuses to start until they are set.
# Generate each one with:  openssl rand -hex 32
# Keep CHECKIN_ENCRYPTION_KEY with your database backups (check-in secrets are encrypted with it).

POSTGRES_PASSWORD=
CHECKIN_ENCRYPTION_KEY=
DASHBOARD_API_SECRET=

# Public URLs (no trailing slash). DASHBOARD_URL is baked into the dashboard image at build
# time: rebuild after changing it (docker compose up -d --build).
DASHBOARD_URL=http://localhost:3000
# Where your apps' SDKs send telemetry (the API's ingest endpoint).
API_PUBLIC_URL=http://localhost:3001

# Ports are published on 127.0.0.1 only. Put a TLS reverse proxy in front, or set
# BIND_ADDRESS=0.0.0.0 to listen on all interfaces (plain HTTP).
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
API_PORT=3001

# The first account can always register. After that, signup is invite-only unless true.
TELEMETRY_ALLOW_REGISTRATION=false

# Optional transactional email (invites, password reset, notifications) via Resend.
RESEND_API_KEY=
TELEMETRY_EMAIL_FROM=
