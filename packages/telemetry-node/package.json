{
  "name": "@telemetry-tracker/node",
  "version": "1.4.0",
  "description": "Telemetry Tracker SDK for Node.js: global error handlers, request middleware.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Telemetry-Tracker/telemetry-tracker.git",
    "directory": "packages/telemetry-node"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/assert-sdk-publish-context.mjs && pnpm run build"
  },
  "keywords": [
    "telemetry",
    "node",
    "server",
    "errors",
    "middleware"
  ],
  "dependencies": {
    "@telemetry-tracker/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
