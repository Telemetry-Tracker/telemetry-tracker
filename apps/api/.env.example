DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry
PORT=3001

# Dashboard auth: allow additional signups after the first user. First signup is always allowed.
# TELEMETRY_ALLOW_REGISTRATION="true"

# When "true", keep dashboard read APIs publicly accessible (legacy mode).
# Default/private mode requires authenticated user sessions for /api/* dashboard reads.
# TELEMETRY_PUBLIC_DASHBOARD="true"
